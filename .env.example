DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
API_SECRET="your-secret-key-here"

# Blog agents (agents/) — providers are tried in order: Grok → Ollama → Groq.
# Set at least one provider key.
SITE_API_URL="http://localhost:3000"

# 1) Grok (xAI) — model-native web search. https://console.x.ai
XAI_API_KEY="xai-your-key-here"
XAI_MODEL="grok-4-6"

# 2) Ollama Cloud — web search + cloud model. https://ollama.com
OLLAMA_API_KEY="your-ollama-key-here"
OLLAMA_MODEL="gpt-oss:120b"

# 3) Groq — fast, no web search. https://console.groq.com
GROQ_API_KEY="gsk_your-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Admin dashboard (/admin) password
ADMIN_PASSWORD="a-strong-password"

# Admin dashboard (/admin) — set a strong password
ADMIN_PASSWORD="a-strong-password"

# Admin dashboard (/admin) — password to sign in
ADMIN_PASSWORD="a-strong-password-here"
